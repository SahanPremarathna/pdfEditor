# Copy to .env.local (or set in your host's environment settings).
# All optional — Inkline works fully without them.

# Overrides the built-in Ko-fi page (https://ko-fi.com/sahantp).
VITE_KOFI_URL=

# Shown in the footer and the support note ("Made with ♥ by …").
VITE_MAKER_NAME=

# Public source repository — shows a "Star on GitHub" option.
VITE_REPO_URL=
